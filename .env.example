# PostgreSQL Database Connection
# ตัวอย่าง: postgresql://username:password@localhost:5432/databasename
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mydb

# หรือกำหนดแยกตัวแปร (หากไม่ต้องการใช้ DATABASE_URL):
# PGHOST=localhost
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=postgres
# PGDATABASE=mydb
# DATABASE_SSL=false
